# ===== 聊天存储服务（MySQL 云同步）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ai_chat_sync
JWT_SECRET=一段足够长的随机字符串
CHAT_STORE_PORT=8001

# ===== 语音合成服务鉴权（留空则不启用鉴权）=====
TTS_API_KEY=

# ===== 图片生成服务鉴权（留空则不启用鉴权）=====
IMG_API_KEY=

# ===== 知识库 / 长期记忆 L2 的嵌入模型（默认已是中文模型，一般无需修改）=====
# 默认 BAAI/bge-small-zh-v1.5（中文，512 维）；只有想换别的模型时才需要填写：
#   KB_EMBED_MODEL=BAAI/bge-base-zh-v1.5            # 仓库名 → local_model/BAAI--bge-base-zh-v1.5
#   KB_EMBED_MODEL_DIR=D:\models\bge-base-zh-v1.5   # 或直接给绝对路径（优先级更高）
# 查询前缀一般无需填写（服务按模型名自动判断）；如需强制覆盖：
#   KB_EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 向量库位置（默认锚定 backend_code/knowledge_base/chroma_db，一般不用填）：
#   CHROMA_DIR=chroma_db
# ⚠ 换模型后向量维度会变，必须重建：python backend_code/knowledge_base/reembed_all.py --include-kb

# ===== Qwen3-TTS 模型路径（按实际情况填写）=====
QWEN_TTS_MODEL_PATH=your/path/to/the/Qwen3-TTS-12Hz-1.7B-Base

# ===== MOSI 云端 API 密钥（用于 MossClient 调用）===== 
MOSS_API_KEY=your-api-key-to-moss