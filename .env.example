# ===== 聊天存储服务（MySQL 云同步）=====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ai_chat_sync
JWT_SECRET=一段足够长的随机字符串
CHAT_STORE_PORT=8001

# ===== 语音合成服务鉴权（留空则不启用鉴权）=====
TTS_API_KEY=

# ===== 图片生成服务鉴权（留空则不启用鉴权）=====
IMG_API_KEY=

# ===== Qwen3-TTS 模型路径（按实际情况填写）=====
QWEN_TTS_MODEL_PATH=your/path/to/the/Qwen3-TTS-12Hz-1.7B-Base

# ===== MOSI 云端 API 密钥（用于 MossClient 调用）===== 
MOSS_API_KEY=your-api-key-to-moss